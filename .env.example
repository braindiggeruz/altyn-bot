# =============================================================================
# ALTYN THERAPY BOT — Environment template (v5.2)
# Copy to .env on VPS (chmod 600, owner root). DO NOT commit real values.
# Generators:
#   openssl rand -base64 48 | tr -d '/+=' | head -c 64   # JWT_SECRET (>=32 chars)
#   openssl rand -hex 24                                   # WEBHOOK_SECRET_PATH (>=16 chars)
#   openssl rand -hex 32                                   # TELEGRAM_SECRET_TOKEN
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32     # POSTGRES_PASSWORD
# =============================================================================

# ---- Telegram ----
BOT_TOKEN=                          # @BotFather — required, no fallback
OWNER_TELEGRAM_ID=                  # Numeric Telegram id of Алтын (gets hot-lead pings)
NOTIFY_GROUP_ID=                    # Optional admin group chat id (negative number)
OWNER_DIRECT_URL=https://t.me/Altyn2304  # Hot CTA link shown to end users

# ---- Webhook ----
WEBHOOK_URL=https://bot.altyn-therapy.uz      # Public host of the bot (no trailing slash)
WEBHOOK_SECRET_PATH=                # ≥16 chars random slug (used in /tg/<slug>)
TELEGRAM_SECRET_TOKEN=              # Sent in X-Telegram-Bot-Api-Secret-Token, verified by app

# ---- Admin / API ----
JWT_SECRET=                         # ≥32 chars random secret — no fallback in code
ADMIN_USERNAME=
ADMIN_PASSWORD=                     # Bootstraps admin_users on first login; rotate via runbook
ADMIN_TRIGGER_SECRET=               # Gates /debug, /admin/trigger/*, /admin/tornado/*
CORS_ORIGINS=https://altyn-therapy.uz,https://admin.altyn-therapy.uz,https://bot.altyn-therapy.uz

# ---- Database (loopback-only Postgres in compose) ----
POSTGRES_USER=altyn
POSTGRES_PASSWORD=
POSTGRES_DB=altyn
DATABASE_URL=postgres://altyn:${POSTGRES_PASSWORD}@postgres:5432/altyn?sslmode=disable

# ---- Hostnames (used by Caddyfile) ----
BOT_HOSTNAME=bot.altyn-therapy.uz
ADMIN_HOSTNAME=admin.altyn-therapy.uz
LETSENCRYPT_EMAIL=ops@altyn-therapy.uz

# ---- Optional ----
# OWNER_WA_URL=https://wa.me/998...   # ONLY if Алтын actually has a WhatsApp number
# OWNER_INSTAGRAM_URL=https://instagram.com/altyn.therapy
BACKUP_RETENTION_DAYS=14
PORT=4000
