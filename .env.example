# ===== ALTYN Therapy Bot — example env =====
# Copy to .env on the VPS (/srv/altyn/.env). Never commit real values.

# Core
BOT_TOKEN=
DATABASE_URL=
JWT_SECRET=
PORT=4000

# Notifications
OWNER_TELEGRAM_ID=
NOTIFY_GROUP_ID=

# Webhook (Railway/VPS public host)
WEBHOOK_URL=

# Admin trigger secret (for /admin/trigger/* and TORNADO ops)
ADMIN_TRIGGER_SECRET=

# Tornado kill switch (1 = enabled, 0 = paused)
TORNADO_ENABLED=1

# ===== ALTYN Mirror ingest (Phase 2.2) =====
# Default is OFF. Flip to 'true' ONLY after MIRROR_INGEST_TOKEN is configured
# on BOTH backend (.env here) AND Cloudflare Pages env for altyn-mirror.
MIRROR_INGEST_ENABLED=false
# Shared secret. Generate ONCE per environment with `openssl rand -hex 32`.
# Must match the value set in Cloudflare Pages → altyn-mirror → Settings → Env.
MIRROR_INGEST_TOKEN=
# Optional: per-IP rate limit for /api/mirror/event (default 60/min).
MIRROR_INGEST_RATE_PER_MIN=60
